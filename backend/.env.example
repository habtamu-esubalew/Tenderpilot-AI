# =============================================================================
# TenderPilot AI — Backend (copy to backend/.env; never commit real secrets)
# =============================================================================

PORT=5000

# Resolved relative to prisma/schema.prisma. Optional ?busy_timeout=120000 reduces SQLite lock errors during long AI retries.
DATABASE_URL="file:./dev.db"

FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AI — Gemini
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Recommended: gemini-2.5-flash or gemini-flash-latest (see Google AI docs for your key).
GEMINI_MODEL=gemini-2.5-flash

# true = always use built-in mock analysis (offline demo safe).
ENABLE_MOCK_AI=true

# When false + live key: Gemini errors surface as HTTP 502 instead of silent mock (recommended for graded review).
GEMINI_SILENT_FALLBACK=false

GEMINI_RETRY_ON_429=true

# -----------------------------------------------------------------------------
# Email — SendGrid
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
DEFAULT_NOTIFICATION_EMAIL=

ENABLE_EMAIL=false

# -----------------------------------------------------------------------------
# Calendar — Google Calendar API (optional template link always works)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Documented target calendar; inserts in code currently use Google calendarId 'primary'.
GOOGLE_CALENDAR_ID=primary

ENABLE_CALENDAR=false

# -----------------------------------------------------------------------------
# Reminders — cron 09:00 local + POST /api/agent/run-deadline-check
# -----------------------------------------------------------------------------
ENABLE_REMINDERS=true
